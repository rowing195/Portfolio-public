---
interface Props {
  eyebrow: string;
  entries: {
    title: string;
    summary: string;
    tags: string[];
    /** 摘要跨頁編號;undefined 表示佔位條目(不可點擊) */
    goto?: number;
    /** 單頁模式的目標頁碼(選填)。goto 寫的是「跨頁編號」,引擎在單頁
        模式會換算成該跨頁的左頁(navTarget:2n-1);若目標其實在右頁,
        就得用這個覆寫,否則手機上會落到隔壁那一頁。 */
    gotoSingle?: number;
  }[];
  pageno: string;
}
const { eyebrow, entries, pageno } = Astro.props;
---

<section data-toc-btn>
  <div class="eyebrow">{eyebrow}</div>
  <div class="item-scroll">
    {
      entries.map((e) =>
        e.goto != null ? (
          <button class="entry" data-goto={e.goto} data-goto-single={e.gotoSingle}>
            <span class="t">{e.title}</span>
            <span class="s">{e.summary}</span>
            {e.tags.length > 0 && (
              <span class="tags">
                {e.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </span>
            )}
          </button>
        ) : (
          <div class="entry static">
            <span class="t">{e.title}</span>
            <span class="s">{e.summary}</span>
            {e.tags.length > 0 && (
              <span class="tags">
                {e.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </span>
            )}
          </div>
        )
      )
    }
  </div>
  <div class="pageno">· {pageno} ·</div>
</section>
