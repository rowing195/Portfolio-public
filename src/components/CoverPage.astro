---
interface Props {
  latin: string;
  title: string;
  author: string;
}
const { latin, title, author } = Astro.props;

/* 四角紋飾:雙弧線 + 四芒星,stroke/fill 用 currentColor,
   讓開場 burnFade 動畫的 color 變化能直接套用到 SVG 上 */
const flourish = `<svg viewBox="0 0 40 40" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-linecap="round">
    <path d="M3 37 C3 12 12 3 37 3" stroke-width="1.6"/>
    <path d="M3 26 C3 11 11 3 26 3" stroke-width="1" opacity=".65"/>
  </g>
  <path d="M14 8 L15.8 12.2 20 14 15.8 15.8 14 20 12.2 15.8 8 14 12.2 12.2 Z" fill="currentColor"/>
</svg>`;
---

<section data-cover>
  <div class="cover-frame">
    <!-- 【2026-07 canvas 化】原 SVG 火線移除,改由 burn-intro.js 的 canvas 繪製 -->
    <i class="corner tl" set:html={flourish} />
    <i class="corner tr" set:html={flourish} />
    <i class="corner br" set:html={flourish} />
    <i class="corner bl" set:html={flourish} />
  </div>

  <!-- 奧術法陣底紋:置於標題後方,極淡金色、緩慢旋轉(純 transform,合成層便宜) -->
  <svg class="sigil" viewBox="0 0 120 120" aria-hidden="true">
    <g fill="none" stroke="currentColor">
      <circle cx="60" cy="60" r="57" stroke-width=".5"/>
      <circle cx="60" cy="60" r="52" stroke-width=".3" stroke-dasharray="1.5 3.5"/>
      <circle cx="60" cy="60" r="36" stroke-width=".4"/>
      <circle cx="60" cy="60" r="10" stroke-width=".4"/>
      <rect x="35" y="35" width="50" height="50" stroke-width=".35"/>
      <rect x="35" y="35" width="50" height="50" stroke-width=".35" transform="rotate(45 60 60)"/>
      <g stroke-width=".4">
        <path d="M60 3 v6"/>
        <path d="M60 3 v6" transform="rotate(45 60 60)"/>
        <path d="M60 3 v6" transform="rotate(90 60 60)"/>
        <path d="M60 3 v6" transform="rotate(135 60 60)"/>
        <path d="M60 3 v6" transform="rotate(180 60 60)"/>
        <path d="M60 3 v6" transform="rotate(225 60 60)"/>
        <path d="M60 3 v6" transform="rotate(270 60 60)"/>
        <path d="M60 3 v6" transform="rotate(315 60 60)"/>
      </g>
    </g>
    <g fill="currentColor">
      <path d="M60 .6 l1.5 2.9 -1.5 2.9 -1.5 -2.9 Z"/>
      <path d="M60 .6 l1.5 2.9 -1.5 2.9 -1.5 -2.9 Z" transform="rotate(90 60 60)"/>
      <path d="M60 .6 l1.5 2.9 -1.5 2.9 -1.5 -2.9 Z" transform="rotate(180 60 60)"/>
      <path d="M60 .6 l1.5 2.9 -1.5 2.9 -1.5 -2.9 Z" transform="rotate(270 60 60)"/>
    </g>
  </svg>

  <div class="cover-inner">
    <div class="latin" set:html={latin.split(' ').join('&nbsp;')} />
    <h1>{title}</h1>
    <div class="owner">{author} 著</div>
    <div class="rule"></div>
    <div class="hint">✦ 輕觸以開卷 ✦</div>
  </div>
</section>
